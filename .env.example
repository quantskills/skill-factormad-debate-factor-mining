# Copy this file to .env for local real runs.
# Do not commit .env.

# Required for real LLM-backed debate runs.
OPENAI_API_KEY=

# Optional model default used when input JSON llm_name is empty.
OPENAI_MODEL=gpt-4o-mini

# Optional. Set only when using an OpenAI-compatible endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional FactorMAD-specific overrides. These take precedence over OPENAI_* variables.
# FACTORMAD_OPENAI_API_KEY=
# FACTORMAD_OPENAI_MODEL=gpt-4o-mini
# FACTORMAD_OPENAI_BASE_URL=https://api.openai.com/v1
